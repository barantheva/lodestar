# ==============================================================================
# Lodestar Connection Properties & Environment Configuration
# ==============================================================================

# --- Relay Team Mode ---
# solo (default): you self-sign Guard 1 and Guard 3 — a pause-and-review checkpoint, not an independence check.
# team: a separate Analyst and Lead sign, per Relay's real rule — requires ANALYST_NAME/LEAD_NAME below.
TEAM_MODE=solo
# ANALYST_NAME=
# LEAD_NAME=
# Off by default, matches Relay's rule — set true to let monitoring declare Sev-0/Sev-1 itself instead of waiting for a human (architecture.md §1)
ALLOW_AUTONOMOUS_INCIDENT_DECLARATION=false

# --- GitHub Connection ---
GITHUB_TOKEN=
# Comma-separated owner/repo list — the poller fans out across all of them from one daemon
GITHUB_REPO=
GITHUB_BASE_BRANCH=main
ISSUE_LABEL_FILTER=agent-todo

# --- Auto Coder Providers ---
# Options: claude, gemini, kimi, deepseek, openai, auto
PRIMARY_AUTO_CODER=claude
# Comma-separated fallbacks if primary is rate-limited or fails
FALLBACK_AUTO_CODERS=gemini,kimi,deepseek,openai

# --- Anthropic / Claude Code ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-7-sonnet-20250219
CLAUDE_BINARY_PATH=/usr/local/bin/claude
# Pass --dangerously-skip-permissions for headless runs
CLAUDE_SKIP_PERMISSIONS=true

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Moonshot / Kimi ---
KIMI_API_KEY=
KIMI_MODEL=moonshot-v1-128k
KIMI_BASE_URL=https://api.moonshot.cn/v1

# --- DeepSeek ---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# --- 4-Agent Relay Pipeline (relay-implementer / relay-stop-slop / relay-reviewer / relay-auditor) ---
# relay-implementer uses PRIMARY_AUTO_CODER (or --provider). relay-reviewer/relay-auditor are
# deterministic (test run + evidence generation), no provider needed. relay-stop-slop is the one
# other LLM-judged stage — defaults to PRIMARY_AUTO_CODER if unset, override independently here.
# Options: claude, gemini, kimi, deepseek, openai
# RELAY_STOP_SLOP_PROVIDER=

# --- Fleet & Dashboard ---
DASHBOARD_PORT=3000
# How many named workers the fleet supervisor runs — add one AGENT_N_PROVIDER/AGENT_N_JOB pair per worker
AGENT_COUNT=3
AGENT_1_PROVIDER=claude
AGENT_1_JOB=incident-monitor      # app/log & incident monitor
AGENT_2_PROVIDER=deepseek
AGENT_2_JOB=issue-monitor         # GitHub issue monitor (SDD, intent/spec approval required)
AGENT_3_PROVIDER=claude
AGENT_3_JOB=codebase-monitor      # commit/deploy watcher, re-indexes knowledge, updates existing PRs
# Job types: incident-monitor, issue-monitor, codebase-monitor, instrumentation-campaign

# --- Rate Limit & Usage Sentinel ---
# Wait automatically when quota/rate-limit hit instead of aborting
AUTO_WAIT_ON_RATE_LIMIT=true
# Additional buffer seconds to sleep after reported reset time
RATE_LIMIT_WAIT_BUFFER_SECONDS=60
# Max wait time in minutes before switching to fallback (0 = wait indefinitely)
MAX_RATE_LIMIT_WAIT_MINUTES=360

# --- Persistent Data Nexus & Storage ---
# Which memory-interface.ts implementation stores project knowledge, decisions, and Guard
# documents. Both back onto plain markdown; this only picks who serves persist/retrieve calls.
# Options: loadstonenexus (default), obsidian
KNOWLEDGE_BACKEND=loadstonenexus

# -- loadstonenexus backend --
# Central persistent storage for knowledge bases, Jolli memory, metrics, and graphs
DATA_DIR=/Users/ragu/Code/LoadstoneNexus
KNOWLEDGE_BASE_DIR=/Users/ragu/Code/LoadstoneNexus/knowledge
# local = stdio server on this host, reads/writes DATA_DIR directly
# remote = shared server another instance/team already runs; set LOADSTONENEXUS_MCP_URL
LOADSTONENEXUS_MCP_MODE=local
LOADSTONENEXUS_MCP_URL=

# -- obsidian backend --
# Path to the Obsidian vault; project knowledge/decisions/Guard documents are written as notes,
# one folder per collection (e.g. <vault>/guard-documents/<track_id>/intent.md)
OBSIDIAN_VAULT_PATH=
# Obsidian has no MCP server of its own — this points at the Local REST API plugin endpoint
# a small MCP bridge wraps. Default plugin port shown.
OBSIDIAN_MCP_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=

# --- Organizational Gateways (run notifications) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
WHATSAPP_API_TOKEN=
# Comma-separated recipient numbers
WHATSAPP_BROADCAST_LIST=
SMTP_URL=
# Comma-separated recipient addresses
ALERT_EMAIL_TO=

# --- Repo Knowledge Base & Graph Intelligence ---

# --- Hanoi Rainbow Spec-Driven Development ---
AUTO_SEMANTIC_COMMITS=true

# --- Autonomous Daemon Polling ---
POLL_INTERVAL_SECONDS=60
